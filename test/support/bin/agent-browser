#!/usr/bin/env node
// Fake agent-browser: records every call, and on `open <url>` plays the user who
// signs in to Claude in that window (as FAKE_BROWSER_EMAIL, else FAKE_LOGIN_EMAIL).
// Refuse to run outside a test sandbox: a fake pointed at a real config dir would
// overwrite that login's .claude.json (this happened once in development).
{
  const sb = process.env.FAKE_SANDBOX
  const within = (p) => typeof p === "string" && sb && (p === sb || p.startsWith(sb + "/"))
  if (!sb || !process.env.FAKE_STATE || !within(process.env.HOME) || (process.env.CLAUDE_CONFIG_DIR !== undefined && !within(process.env.CLAUDE_CONFIG_DIR))) {
    console.error("fake: refusing to run outside FAKE_SANDBOX")
    process.exit(3)
  }
}
const fs = require("node:fs")
const path = require("node:path")
const state = process.env.FAKE_STATE
const args = process.argv.slice(2)
fs.appendFileSync(path.join(state, "agent-browser-calls.jsonl"), JSON.stringify(args) + "\n")
if (args[0] === "--version") {
  console.log("agent-browser 0.38.1")
  process.exit(0)
}
const i = args.indexOf("open")
if (i >= 0) {
  const email = process.env.FAKE_BROWSER_EMAIL || process.env.FAKE_LOGIN_EMAIL
  fs.writeFileSync(path.join(state, "browser-signed-in"), email)
}
process.exit(0)
