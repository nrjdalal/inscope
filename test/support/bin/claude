#!/usr/bin/env node
// Fake `claude` for the CLI tests: answers `auth status --json` from the Keychain slot
// Claude Code derives from the LITERAL CLAUDE_CONFIG_DIR string (computed here
// independently of inscope) and that login's .claude.json, the way `inscope status`
// reads a login that does not go through the proxy.
// Refuse to run outside a test sandbox: a fake pointed at a real config dir would
// overwrite that login's .claude.json (this happened once in development). The sandbox
// must be a fresh `inscope-acct-*` dir under the OS temp dir, and HOME, FAKE_STATE, and
// any CLAUDE_CONFIG_DIR must all sit inside it.
{
  const fs = require("node:fs")
  const os = require("node:os")
  const path = require("node:path")
  const real = (p) => {
    try {
      return fs.realpathSync(p)
    } catch {
      return null
    }
  }
  const sb = process.env.FAKE_SANDBOX && real(process.env.FAKE_SANDBOX)
  const tmp = real(os.tmpdir())
  const inside = (p) => {
    const r = typeof p === "string" ? real(p) ?? path.resolve(p) : null
    return Boolean(sb && r && (r === sb || r.startsWith(sb + path.sep)))
  }
  const ok =
    sb &&
    tmp &&
    path.dirname(sb) === tmp &&
    path.basename(sb).startsWith("inscope-acct-") &&
    inside(process.env.HOME) &&
    inside(process.env.FAKE_STATE) &&
    (process.env.CLAUDE_CONFIG_DIR === undefined || inside(process.env.CLAUDE_CONFIG_DIR))
  if (!ok) {
    console.error("fake: refusing to run outside a FAKE_SANDBOX temp dir")
    process.exit(3)
  }
}
const { createHash } = require("node:crypto")
const fs = require("node:fs")
const path = require("node:path")

const state = process.env.FAKE_STATE
const ccd = process.env.CLAUDE_CONFIG_DIR
const args = process.argv.slice(2)
fs.appendFileSync(
  path.join(state, "claude-calls.jsonl"),
  JSON.stringify({
    args,
    ccd: ccd ?? null,
    cwd: process.cwd(),
    credentialVars: ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_OAUTH_TOKEN"].filter(
      (k) => process.env[k] !== undefined,
    ),
  }) + "\n",
)

const slot = () =>
  ccd === undefined
    ? "Claude Code-credentials"
    : `Claude Code-credentials-${createHash("sha256").update(ccd.normalize("NFC")).digest("hex").slice(0, 8)}`
const kcFile = path.join(state, "keychain.json")
const kc = () => (fs.existsSync(kcFile) ? JSON.parse(fs.readFileSync(kcFile, "utf8")) : {})
const metaFile = () => path.join(ccd ?? path.join(process.env.HOME, ".claude"), ".claude.json")

if (args[0] === "auth" && args[1] === "status") {
  const tok = kc()[slot()]
  let email
  try {
    email = JSON.parse(fs.readFileSync(metaFile(), "utf8")).oauthAccount.emailAddress
  } catch {}
  if (!tok || !email) {
    console.log(JSON.stringify({ loggedIn: false }))
    process.exit(1)
  }
  console.log(JSON.stringify({ loggedIn: true, authMethod: "claude.ai", email, subscriptionType: "max" }))
  process.exit(0)
}

console.error(`fake claude: unsupported ${args.join(" ")}`)
process.exit(2)
