#!/usr/bin/env node
// Fake macOS `security` over a JSON file, for the generic-password calls inscope makes.
// Refuse to run outside a test sandbox: a fake pointed at a real config dir would
// overwrite that login's .claude.json (this happened once in development). The sandbox
// must be a fresh `inscope-acct-*` dir under the OS temp dir, and HOME, FAKE_STATE, and
// any CLAUDE_CONFIG_DIR must all sit inside it.
{
  const fs = require("node:fs")
  const os = require("node:os")
  const path = require("node:path")
  const real = (p) => {
    try {
      return fs.realpathSync(p)
    } catch {
      return null
    }
  }
  const sb = process.env.FAKE_SANDBOX && real(process.env.FAKE_SANDBOX)
  const tmp = real(os.tmpdir())
  const inside = (p) => {
    const r = typeof p === "string" ? real(p) ?? path.resolve(p) : null
    return Boolean(sb && r && (r === sb || r.startsWith(sb + path.sep)))
  }
  const ok =
    sb &&
    tmp &&
    path.dirname(sb) === tmp &&
    path.basename(sb).startsWith("inscope-acct-") &&
    inside(process.env.HOME) &&
    inside(process.env.FAKE_STATE) &&
    (process.env.CLAUDE_CONFIG_DIR === undefined || inside(process.env.CLAUDE_CONFIG_DIR))
  if (!ok) {
    console.error("fake: refusing to run outside a FAKE_SANDBOX temp dir")
    process.exit(3)
  }
}
const fs = require("node:fs")
const path = require("node:path")
const file = path.join(process.env.FAKE_STATE, "keychain.json")
const kc = () => (fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, "utf8")) : {})
const [cmd, ...rest] = process.argv.slice(2)
const flag = (f) => {
  const i = rest.indexOf(f)
  return i >= 0 ? rest[i + 1] : undefined
}
const svc = flag("-s")
if (cmd === "find-generic-password") {
  const v = kc()[svc]
  if (v === undefined) {
    console.error("security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.")
    process.exit(44)
  }
  if (rest.includes("-w")) console.log(v)
  process.exit(0)
}
if (cmd === "add-generic-password") {
  const k = kc()
  k[svc] = flag("-w")
  fs.writeFileSync(file, JSON.stringify(k, null, 2))
  process.exit(0)
}
if (cmd === "delete-generic-password") {
  const k = kc()
  if (k[svc] === undefined) process.exit(44)
  delete k[svc]
  fs.writeFileSync(file, JSON.stringify(k, null, 2))
  process.exit(0)
}
process.exit(2)
