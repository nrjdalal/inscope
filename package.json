{
  "name": "inscope",
  "version": "0.17.0",
  "description": "Per-workspace identity for Claude Code: each directory auto-resolves its own login/subscription, MCP servers, GitHub account, and skills.",
  "keywords": [
    "chpwd",
    "claude",
    "claude-code",
    "cli",
    "git",
    "github",
    "identity",
    "isolation",
    "mcp",
    "skills",
    "subscription",
    "workspace",
    "zsh"
  ],
  "homepage": "https://github.com/nrjdalal/inscope#readme",
  "bugs": "https://github.com/nrjdalal/inscope/issues",
  "license": "MIT",
  "author": {
    "name": "Neeraj Dalal",
    "email": "admin@nrjdalal.com",
    "url": "https://nrjdalal.com"
  },
  "repository": "nrjdalal/inscope",
  "funding": "https://github.com/sponsors/nrjdalal",
  "bin": {
    "inscope": "dist/bin/index.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": "./dist/index.mjs",
  "scripts": {
    "bin": "tsdown && node dist/bin/index.mjs",
    "build": "tsdown",
    "changelog": "changelogen --bump",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "lefthook install",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "lefthook": "^2.2.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "~7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
